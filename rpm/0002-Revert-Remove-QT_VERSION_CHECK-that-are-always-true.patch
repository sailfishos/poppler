From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Matti=20Lehtim=C3=A4ki?= <matti.lehtimaki@jolla.com>
Date: Thu, 10 Apr 2025 00:14:15 +0300
Subject: [PATCH] Revert "Remove QT_VERSION_CHECK that are always true"

This reverts commit 18885fcc7398ddaa0769a2ae7acad46d32db02f9.
---
 qt5/src/poppler-annotation.cc | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/qt5/src/poppler-annotation.cc b/qt5/src/poppler-annotation.cc
index 8f146055740002a08c7d775f2a93f0b6b2a36004..17106d0fd715bcb4cca31ec5c285c4e9dc5a3f3c 100644
--- a/qt5/src/poppler-annotation.cc
+++ b/qt5/src/poppler-annotation.cc
@@ -180,7 +180,11 @@ static void getRawDataFromQImage(const QImage &qimg, int bitsPerPixel, std::vect
         break;
     case 8:
     case 24:
+#if QT_VERSION >= QT_VERSION_CHECK(5, 10, 0)
         data->assign(reinterpret_cast<const char *>(qimg.bits()), reinterpret_cast<const char *>(qimg.bits()) + static_cast<int>(qimg.sizeInBytes()));
+#else
+        data->assign(reinterpret_cast<const char *>(qimg.bits()), reinterpret_cast<const char *>(qimg.bits()) + static_cast<int>(qimg.byteCount()));
+#endif
         break;
     case 32:
         data->reserve(3 * height * width);
@@ -1695,7 +1699,11 @@ Annotation::Style Annotation::style() const
         s.setLineStyle(static_cast<Annotation::LineStyle>(1 << border->getStyle()));
 
         const std::vector<double> &dashArray = border->getDash();
+#if QT_VERSION <= QT_VERSION_CHECK(5, 14, 0)
+        s.setDashArray(QVector<double>::fromStdVector(dashArray));
+#else
         s.setDashArray(QVector<double>(dashArray.begin(), dashArray.end()));
+#endif
     }
 
     const AnnotBorderEffect *border_effect;
@@ -3468,12 +3476,14 @@ std::unique_ptr<AnnotStampImageHelper> StampAnnotationPrivate::convertQImageToAn
     case QImage::Format_Grayscale8:
         bitsPerComponent = 8;
         break;
+#if QT_VERSION >= QT_VERSION_CHECK(5, 13, 0)
     case QImage::Format_Grayscale16:
         convertedQImage = convertedQImage.convertToFormat(QImage::Format_Grayscale8);
 
         colorSpace = ColorSpace::DeviceGray;
         bitsPerComponent = 8;
         break;
+#endif
     case QImage::Format_RGB16:
     case QImage::Format_RGB666:
     case QImage::Format_RGB555:
