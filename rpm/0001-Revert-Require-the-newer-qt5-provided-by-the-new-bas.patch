From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pekka Vuorela <pekka.vuorela@jolla.com>
Date: Wed, 18 Aug 2021 10:50:18 +0300
Subject: [PATCH] Revert "Require the newer qt5 provided by the new base CI"

This reverts commit 0b34c18882ee3920c5ab9e9b953b3bb642f1b198.
---
 CMakeLists.txt                |  2 +-
 qt5/CMakeLists.txt            |  2 +-
 qt5/src/poppler-annotation.cc |  4 ++--
 qt5/src/poppler-form.cc       | 10 +++++++---
 qt5/tests/poppler-forms.cpp   |  6 +++++-
 5 files changed, 16 insertions(+), 8 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7c540367ade39e4db2ed4b938936a16d74077109..17de8c7c11b632ae92ee0ec0d7a3cffe3147381f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -161,7 +161,7 @@ set(NSS3_VERSION "3.98")
 set(GPGME_VERSION "1.19")
 set(LCMS2_REQUIRED_VERSION "2.14")
 set(TIFF_VERSION "4.5")
-set(QT5_VERSION "5.15")
+set(QT5_VERSION "5.6")
 set(QT6_VERSION "6.4")
 set(BOOST_VERSION "1.83")
 set(GOBJECT_INTROSPECTION_VERSION "1.80")
diff --git a/qt5/CMakeLists.txt b/qt5/CMakeLists.txt
index bd4194e5ebc461e1fb5b2489844e3350e67e7177..21f2509ce0f6da8049a31aebac0cc9a3a2312ee6 100644
--- a/qt5/CMakeLists.txt
+++ b/qt5/CMakeLists.txt
@@ -5,7 +5,7 @@ if(ENABLE_QT_STRICT_ITERATORS)
   add_definitions(-DQT_STRICT_ITERATORS)
 endif()
 
-add_definitions(-DQT_DISABLE_DEPRECATED_BEFORE=0x050E00)
+add_definitions(-DQT_DISABLE_DEPRECATED_BEFORE=0x050500)
 add_definitions(-DQT_NO_DEPRECATED_WARNINGS)
 
 add_subdirectory(src)
diff --git a/qt5/src/poppler-annotation.cc b/qt5/src/poppler-annotation.cc
index bb05a9d1788a7108225be2ce402e41afae0d5ee9..8f146055740002a08c7d775f2a93f0b6b2a36004 100644
--- a/qt5/src/poppler-annotation.cc
+++ b/qt5/src/poppler-annotation.cc
@@ -1499,7 +1499,7 @@ void Annotation::setModificationDate(const QDateTime &date)
 
     if (d->pdfAnnot) {
         if (date.isValid()) {
-            const time_t t = date.toSecsSinceEpoch();
+            const time_t t = date.toTime_t();
             std::unique_ptr<GooString> s = timeToDateString(&t);
             d->pdfAnnot->setModified(std::move(s));
         } else {
@@ -1537,7 +1537,7 @@ void Annotation::setCreationDate(const QDateTime &date)
     auto *markupann = dynamic_cast<AnnotMarkup *>(d->pdfAnnot.get());
     if (markupann) {
         if (date.isValid()) {
-            const time_t t = date.toSecsSinceEpoch();
+            const time_t t = date.toTime_t();
             std::unique_ptr<GooString> s = timeToDateString(&t);
             markupann->setDate(std::move(s));
         } else {
diff --git a/qt5/src/poppler-form.cc b/qt5/src/poppler-form.cc
index b97522019e1bf86ab3202be849c53513bd07ad57..0e39a5c4e63752984b4edeb1a1b6c7f25080d8b9 100644
--- a/qt5/src/poppler-form.cc
+++ b/qt5/src/poppler-form.cc
@@ -1052,9 +1052,9 @@ static CertificateInfoPrivate *createCertificateInfoPrivate(const X509Certificat
 
         certPriv->nick_name = QString::fromStdString(ci->getNickName().toStr());
 
-        certPriv->validity_start = QDateTime::fromSecsSinceEpoch(std::chrono::duration_cast<std::chrono::seconds>(ci->getValidity().notBefore.time_since_epoch()).count(), QTimeZone::utc());
+        certPriv->validity_start = QDateTime::fromTime_t(std::chrono::duration_cast<std::chrono::seconds>(ci->getValidity().notBefore.time_since_epoch()).count(), Qt::UTC);
         if (ci->getValidity().notAfter != Certificate::timePointSeconds {}) {
-            certPriv->validity_end = QDateTime::fromSecsSinceEpoch(std::chrono::duration_cast<std::chrono::seconds>(ci->getValidity().notAfter.time_since_epoch()).count(), QTimeZone::utc());
+            certPriv->validity_end = QDateTime::fromTime_t(std::chrono::duration_cast<std::chrono::seconds>(ci->getValidity().notAfter.time_since_epoch()).count(), Qt::UTC);
         }
 
         const X509CertificateInfo::PublicKeyInfo &pkInfo = ci->getPublicKeyInfo();
@@ -1165,7 +1165,7 @@ std::pair<SignatureValidationInfo, std::shared_ptr<Poppler::AsyncObject>> FormFi
 {
     auto object = std::make_shared<AsyncObject>();
     auto *fws = static_cast<FormWidgetSignature *>(m_formData->fm);
-    const time_t validationTimeT = validationTime.isValid() ? validationTime.toSecsSinceEpoch() : -1;
+    const time_t validationTimeT = validationTime.isValid() ? validationTime.toTime_t() : -1;
     SignatureInfo *si = fws->validateSignatureAsync(opt & ValidateVerifyCertificate, opt & ValidateForceRevalidation, validationTimeT, !(opt & ValidateWithoutOCSPRevocationCheck), opt & ValidateUseAIACertFetch,
                                                     [obj = std::weak_ptr<AsyncObject>(object)]() {
                                                         if (auto l = obj.lock()) {
@@ -1173,11 +1173,15 @@ std::pair<SignatureValidationInfo, std::shared_ptr<Poppler::AsyncObject>> FormFi
                                                             // to ensure callers have a chance of connecting to AsyncObject::done
                                                             QMetaObject::invokeMethod(
                                                                     l.get(),
+#if QT_VERSION >= QT_VERSION_CHECK(5, 10, 0)
                                                                     [innerObj = std::weak_ptr<AsyncObject>(l)]() {
                                                                         if (auto innerLocked = innerObj.lock()) {
                                                                             Q_EMIT innerLocked->done();
                                                                         }
                                                                     },
+#else
+                                                                    "done",
+#endif
                                                                     Qt::QueuedConnection);
                                                         }
                                                     });
diff --git a/qt5/tests/poppler-forms.cpp b/qt5/tests/poppler-forms.cpp
index 7db7af41bed88f9cbcceb32013cc03a5c6eeaa7e..dc3ea8120f11317032d4865e7c3edcbd738c1330 100644
--- a/qt5/tests/poppler-forms.cpp
+++ b/qt5/tests/poppler-forms.cpp
@@ -264,7 +264,11 @@ int main(int argc, char **argv)
                         std::cout << "\t\t\tSignerName: "
                                   << "(null)" << std::endl;
                     }
-                    const QDateTime sviTime = QDateTime::fromSecsSinceEpoch(svi.signingTime(), Qt::UTC);
+                    // http://doc.qt.io/qt-5/qdatetime.html#fromTime_t-1
+                    // Requires Qt 5.2 -> configure.ac update
+                    // QDateTime::fromTime_t(svi->signingTime(), Qt::UTC).toString();
+                    QDateTime sviTime;
+                    sviTime.setTime_t(svi.signingTime());
                     std::cout << "\t\t\tSigningTime: " << sviTime.toString() << std::endl;
                 } break;
                 }
